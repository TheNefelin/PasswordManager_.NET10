<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="PasswordManager_.NET10.Views.Main.SettingsPage"
             x:Name="thisPage"
             Title="Settings">

    <!-- Grid principal con overlay de loading -->
    <Grid RowDefinitions="*">

        <!-- Contenido principal (ScrollView) -->
        <ScrollView Grid.Row="0" Padding="20">
            <VerticalStackLayout Spacing="20">

                <VerticalStackLayout Spacing="10">
                    <Label Text="GENERAL" FontAttributes="Bold" FontSize="16"/>
                    <Button Text="❓ Manual de Usuario" 
                        Command="{Binding GoToHelpCommand}"/>
                </VerticalStackLayout>

                <!-- BIOMETRÍA -->
                <VerticalStackLayout>
                    <Label 
                        Text="BIOMETRÍA" 
                        FontAttributes="Bold" 
                        FontSize="16"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0">
                        <Label 
                            Grid.Column="0"
                            Text="Activar huella dactilar"
                            FontSize="14"
                            VerticalOptions="Center"/>

                        <Switch Grid.Column="1"                            
                            IsEnabled="{Binding IsBiometricAvailable}"
                            IsToggled="{Binding IsBiometricEnabled}">
                            <Switch.Behaviors>
                                <toolkit:EventToCommandBehavior
                                    EventName="Toggled"
                                    Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.ToggleBiometricCommand}" />
                            </Switch.Behaviors>
                        </Switch>
                    </Grid>

                    <!-- Mensaje de error si no está disponible -->
                    <Label 
                        Text="Este dispositivo no cuenta con biometría"
                        FontSize="12"
                        TextColor="Red"
                        IsVisible="{Binding IsBiometricAvailable, Converter={StaticResource InvertedBoolConverter}}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label 
                             Grid.Column="0"
                             Text="Guardar contraseña"
                             FontSize="14"
                             VerticalOptions="Center"/>

                        <Switch Grid.Column="1"
                            IsEnabled="{Binding IsBiometricEnabled}"
                            IsToggled="{Binding IsSavePasswordEnabled}">
               
                        </Switch>
                    </Grid>

                    <Label 
                         Text="Esta opción no es recomendable, permite el inicio de sesión automático mediante datos biométricos."
                         FontSize="12"
                         TextColor="Red"/>
                </VerticalStackLayout>

                <!-- INFORMACIÓN DE SESIÓN -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="INFORMACIÓN DE SESIÓN" 
                           FontAttributes="Bold" 
                           FontSize="16"/>

                    <!-- Session Time Remaining -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Tiempo de sesión:" FontSize="12" Opacity="0.7"/>
                        <Label Text="{Binding SessionTimeRemaining}"
                               FontSize="14"
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <!-- User ID -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="ID Usuario:" FontSize="12" Opacity="0.7"/>
                        <Entry Grid.Column="0"
                            Text="{Binding UserId}"
                            IsReadOnly="True"
                            FontSize="12"/>
                    </VerticalStackLayout>

                    <!-- Role -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Rol:" FontSize="12" Opacity="0.7"/>
                        <Entry Text="{Binding Role}"
                               IsReadOnly="True"
                               FontSize="12"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- TEMA -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="TEMA" 
                           FontAttributes="Bold" 
                           FontSize="16"/>

                    <Grid ColumnDefinitions="*,*" 
                          ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="☀️ Light"
                                Command="{Binding ChangeThemeCommand}"
                                CommandParameter="Light">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedTheme}"
                                             Value="Light">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                    <Setter Property="TextColor" Value="{StaticResource White}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedTheme}"
                                             Value="Dark">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1"
                                Text="🌙 Dark"
                                Command="{Binding ChangeThemeCommand}"
                                CommandParameter="Dark">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedTheme}"
                                             Value="Dark">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                    <Setter Property="TextColor" Value="{StaticResource White}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedTheme}"
                                             Value="Light">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <Label Text="{Binding SelectedTheme, StringFormat='Tema actual: {0}'}"
                           FontSize="12"
                           Opacity="0.7"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <!-- TOKENS -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="TOKENS" 
                           FontAttributes="Bold" 
                           FontSize="16"/>

                    <!-- API Token -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="API Token:" FontSize="12" Opacity="0.7"/>
                        <Editor Grid.Column="0"
                            Text="{Binding ApiToken}"
                            IsReadOnly="True"
                            FontSize="10"
                            FontFamily="Courier"/>
                    </VerticalStackLayout>

                    <!-- SQL Token -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="SQL Token:" FontSize="12" Opacity="0.7"/>
                        <Entry
                            Text="{Binding SqlToken}"
                            IsReadOnly="True"
                            FontSize="10"
                            FontFamily="Courier"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- INFORMACIÓN DE APP -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="INFORMACIÓN" 
                           FontAttributes="Bold" 
                           FontSize="16"/>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Versión:" FontSize="12" Opacity="0.7"/>
                        <Label Text="{Binding AppVersion}" FontSize="12"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay (encima del contenido) -->
        <VerticalStackLayout Grid.Row="0"
                            IsVisible="{Binding IsLoading}"
                            Spacing="20"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            BackgroundColor="#80000000"
                            Padding="20">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                              IsVisible="{Binding IsLoading}"
                              Scale="1.5"/>
            <Label Text="Cargando información..." 
                   HorizontalOptions="Center"
                   FontSize="14"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>